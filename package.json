{
  "name": "hugmyfile",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "astro dev",
    "setup:assets": "node scripts/setup-assets.mjs",
    "setup:tessdata": "node scripts/download-tessdata.mjs",
    "brand": "node scripts/make-brand-assets.mjs",
    "prebuild": "node scripts/setup-assets.mjs",
    "build": "astro build",
    "postbuild": "node scripts/license-report.mjs && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "fixtures": "node tests/fixtures/generate.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test": "npm run test:unit && npm run test:e2e",
    "licenses:update": "node scripts/license-report.mjs --update",
    "test:report": "node scripts/test-report.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/great-vibes": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/sacramento": "5.3.0",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@pdf-lib/fontkit": "1.1.1",
    "astro": "7.4.4",
    "fflate": "0.8.3",
    "lucide": "1.64.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "preact": "10.29.8",
    "qr-code-styling": "1.9.2",
    "signature_pad": "5.1.4",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.23.4"
  }
