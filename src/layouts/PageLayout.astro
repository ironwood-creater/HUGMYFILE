---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { absoluteUrl } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  lead?: string;
  updated?: string;
}
const { title, description, path, h1, lead, updated } = Astro.props;
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: h1, item: absoluteUrl(path) },
  ],
};
---
<BaseLayout title={title} description={description} path={path} jsonLd={[breadcrumbJson]}>
  <div class="mx-auto max-w-3xl px-4 pt-6">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: h1 }]} />
    <h1 class="mt-4 text-3xl font-extrabold leading-tight md:text-4xl">{h1}</h1>
    {lead && <p class="mt-3 text-lg text-muted">{lead}</p>}
    {updated && <p class="mt-2 text-sm text-muted">Last updated: {updated}</p>}
    <div class="prose-hug mt-8">
      <slot />
    </div>
  </div>
</BaseLayout>
