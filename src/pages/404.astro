---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import ToolCard from '../components/ToolCard.astro';
import { getTool } from '../data/tools';
const popular = ['compress-image', 'merge-pdf', 'qr-code-generator', 'sign-pdf', 'image-to-text', 'jpg-to-pdf'].map(getTool);
---
<BaseLayout title="Page not found | HugMyFile" description="This page wandered off. Find all free HugMyFile tools on the homepage." path="/404" noindex>
  <div class="mx-auto max-w-3xl px-4 py-16 text-center">
    <div class="flex justify-center"><Logo size={80} showText={false} /></div>
    <h1 class="mt-6 text-3xl font-extrabold md:text-4xl">We couldn’t find that page</h1>
    <p class="mt-3 text-lg text-muted">It may have moved, or the link has a typo.</p>
    <h2 class="mt-8 text-xl font-extrabold">Tools people love</h2>
    <ul class="mt-4 grid gap-3 text-left sm:grid-cols-2">
      {popular.map((tool) => <li><ToolCard tool={tool} /></li>)}
    </ul>
    <a href="/" class="btn btn-primary mt-8">See all tools</a>
  </div>
</BaseLayout>
