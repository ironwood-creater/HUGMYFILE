---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Badge from '../components/Badge.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import AdSlot from '../components/AdSlot.astro';
import Icon from '../components/Icon.astro';
import ToolIsland from '../components/ToolIsland.astro';
import GuideCard from '../components/GuideCard.astro';
import { guidesForTool } from '../data/guides';
import { TOOLS, CATEGORIES, type ToolDef } from '../data/tools';
import { CONTENT } from '../data/content';
import type { ToolContent } from '../data/content/types';
import { absoluteUrl } from '../lib/site';
import { t } from '../i18n/ui';

export function getStaticPaths() {
  return TOOLS.filter((tool) => CONTENT[tool.slug]).map((tool) => ({
    params: { tool: tool.slug },
    props: { tool, content: CONTENT[tool.slug]! },
  }));
}

interface Props {
  tool: ToolDef;
  content: ToolContent;
}
const { tool, content } = Astro.props;
const s = t();
const category = CATEGORIES.find((c) => c.id === tool.category)!;
const path = `/${tool.slug}`;
const island = tool.island;
const guides = guidesForTool(tool.slug);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: tool.name,
    description: tool.description,
    url: absoluteUrl(path),
    applicationCategory: tool.category === 'pdf' || tool.category === 'ocr' ? 'BusinessApplication' : 'MultimediaApplication',
    operatingSystem: 'Any (runs in a modern web browser)',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'HugMyFile', url: absoluteUrl('/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: category.label, item: `${absoluteUrl('/')}#${category.id}` },
      { '@type': 'ListItem', position: 3, name: tool.name, item: absoluteUrl(path) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  },
];
---
<BaseLayout title={tool.title} description={tool.description} path={path} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 pt-5">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: category.label, href: `/#${category.id}` }, { name: tool.name }]} />
    <header class="mt-4">
      <div class="flex items-start gap-4">
        <span class="hidden size-14 shrink-0 place-items-center rounded-2xl bg-surface-2 text-link sm:grid"><Icon name={tool.icon} size={28} /></span>
        <div>
          <h1 class="text-3xl font-extrabold leading-tight tracking-tight md:text-4xl">{tool.h1}</h1>
          <p class="mt-2 text-lg text-muted">{tool.lead}</p>
        </div>
      </div>
      <div class="mt-4"><Badge /></div>
    </header>

    <section class="mt-6" aria-label={`${tool.name} tool`} id="tool" data-testid="tool-root">
      <ToolIsland island={island} />
    </section>
  </div>

  <div class="mx-auto max-w-3xl px-4">
    <article class="prose-hug mt-12" data-testid="tool-content">
      {content.intro.map((p) => <p set:html={p} />)}

      <h2>{s.howToUse}</h2>
      <ol data-testid="how-to">
        {content.steps.map((step) => <li set:html={step} />)}
      </ol>

      <h2>{s.features}</h2>
      <ul>
        {content.features.map((f) => <li set:html={f} />)}
      </ul>

      <AdSlot position="in-content" />

      {content.extra && (
        <>
          <h2>{content.extra.heading}</h2>
          {content.extra.paragraphs.map((p) => <p set:html={p} />)}
        </>
      )}

      <div class="card not-prose mt-8 flex gap-4 p-5">
        <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent"><Icon name="ShieldCheck" size={22} /></span>
        <div>
          <h2 class="!mt-0 !mb-1 !text-lg">{s.privacyNoteTitle}</h2>
          <p class="!mb-0 text-muted">{s.privacyNote}</p>
        </div>
      </div>
    </article>

    <Faq items={content.faqs} />

    {guides.length > 0 && (
      <section aria-labelledby="tool-guides-heading" class="mt-12" data-testid="tool-guides">
        <h2 id="tool-guides-heading" class="mb-4 text-2xl font-extrabold">Helpful guides</h2>
        <ul class="grid gap-3">
          {guides.map((guide) => <li><GuideCard guide={guide} /></li>)}
        </ul>
      </section>
    )}
  </div>

  <div class="mx-auto max-w-5xl px-4">
    <RelatedTools slugs={tool.related} />
  </div>

  <AdSlot position="bottom" />
</BaseLayout>
