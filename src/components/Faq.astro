---
import Icon from './Icon.astro';
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}
const { items, heading = 'Frequently asked questions' } = Astro.props;
---
<section aria-labelledby="faq-heading" class="mt-12" data-testid="faq">
  <h2 id="faq-heading" class="mb-4 text-2xl font-extrabold">{heading}</h2>
  <div class="grid gap-3">
    {items.map((item) => (
      <details class="group card px-5 py-4">
        <summary class="flex list-none items-start justify-between gap-4 font-bold">
          <span>{item.q}</span>
          <Icon name="Plus" size={20} class="mt-0.5 shrink-0 text-link transition-transform group-open:rotate-45" />
        </summary>
        <p class="mt-3 leading-relaxed text-muted" set:html={item.a} />
      </details>
    ))}
  </div>
</section>
