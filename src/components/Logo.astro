---
import mark from '../assets/brand/logo-mark.svg?raw';
interface Props {
  size?: number;
  showText?: boolean;
  class?: string;
}
const { size = 40, showText = true, class: className = '' } = Astro.props;
const uid = `hmf-arms-${Math.random().toString(36).slice(2, 8)}`;
const svg = mark.replaceAll('hmf-arms', uid).replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `).replace(' role="img" aria-label="HugMyFile"', '');
---
<span class={`inline-flex items-center gap-2 ${className}`}>
  <span class="inline-block shrink-0" style={`width:${size}px;height:${size}px`} set:html={svg} />
  {showText && (
    <span class="text-[1.35rem] font-extrabold tracking-tight text-fg">
      Hug<span class="text-coral-600 dark:text-coral-400">My</span>File
    </span>
  )}
</span>
