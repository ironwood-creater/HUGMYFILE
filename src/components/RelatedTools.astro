---
import ToolCard from './ToolCard.astro';
import { getTool } from '../data/tools';
interface Props {
  slugs: string[];
}
const tools = Astro.props.slugs.map(getTool);
---
<section aria-labelledby="related-heading" class="mt-14" data-testid="related-tools">
  <h2 id="related-heading" class="mb-4 text-2xl font-extrabold">Related tools</h2>
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {tools.map((tool) => <li><ToolCard tool={tool} /></li>)}
  </ul>
</section>
